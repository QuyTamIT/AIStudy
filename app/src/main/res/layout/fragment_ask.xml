<?xml version="1.0" encoding="utf-8"?>
<!-- Deep Sage / Operate: composer first, then a flat subject-index of editable prompts.
     Native controls, a 640dp column, and growing text keep the task usable with the IME. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ask_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/answer_background" android:fillViewport="true"
    android:clipToPadding="false" android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/answer_page_gutter" android:orientation="vertical"
            android:paddingTop="@dimen/answer_space_6" android:paddingBottom="@dimen/answer_space_8"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/study_workspace_width">
            <include layout="@layout/include_study_brand" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_8" android:accessibilityHeading="true"
                android:text="@string/ask_title" android:textAppearance="@style/TextAppearance.AIStudy.Study.Display" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_2" android:text="@string/ask_subtitle"
                android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6" android:labelFor="@id/edit_question"
                android:text="@string/ask_question_label" android:textAppearance="@style/TextAppearance.AIStudy.Answer.Subject" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_question"
                style="@style/Widget.AIStudy.Study.Input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_3" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_question"
                    style="@style/Widget.AIStudy.Study.EditText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/study_composer_height" android:minLines="4"
                    android:gravity="top|start" android:hint="@string/ask_hint"
                    android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no" android:breakStrategy="high_quality" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/tv_ask_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_3" android:background="@drawable/bg_answer_error"
                android:padding="@dimen/answer_space_4" android:drawableStart="@drawable/ic_study_error"
                android:drawablePadding="@dimen/answer_space_3" android:gravity="center_vertical"
                android:accessibilityLiveRegion="polite" android:visibility="gone"
                android:textAppearance="@style/TextAppearance.AIStudy.Study.Error" tools:text="@string/ask_error_network" />

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_4">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_send"
                    style="@style/Widget.AIStudy.Study.Primary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/ask_send" />
            </FrameLayout>
            <LinearLayout android:id="@+id/progress_loading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_3"
                android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"
                android:accessibilityLiveRegion="polite">
                <ProgressBar android:layout_width="20dp" android:layout_height="20dp"
                    android:indeterminateTint="@color/answer_primary" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="@dimen/answer_space_3" android:text="@string/study_ask_loading_detail"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_8" android:layout_marginBottom="@dimen/answer_space_2"
                android:accessibilityHeading="true" android:text="@string/ask_suggestions_title"
                android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_suggestion_1"
                    style="@style/Widget.AIStudy.Study.Suggestion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/ask_suggestion_1" app:icon="@drawable/ic_study_math" />
                <ImageView style="@style/Widget.AIStudy.Study.RowArrow" />
            </FrameLayout>
            <View style="@style/Widget.AIStudy.Study.Rule" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_suggestion_2"
                    style="@style/Widget.AIStudy.Study.Suggestion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/ask_suggestion_2" app:icon="@drawable/ic_study_science" />
                <ImageView style="@style/Widget.AIStudy.Study.RowArrow" />
            </FrameLayout>
            <View style="@style/Widget.AIStudy.Study.Rule" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_suggestion_3"
                    style="@style/Widget.AIStudy.Study.Suggestion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/ask_suggestion_3" app:icon="@drawable/ic_study_code" />
                <ImageView style="@style/Widget.AIStudy.Study.RowArrow" />
            </FrameLayout>
            <View style="@style/Widget.AIStudy.Study.Rule" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_suggestion_4"
                    style="@style/Widget.AIStudy.Study.Suggestion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/ask_suggestion_4" app:icon="@drawable/ic_study_language" />
                <ImageView style="@style/Widget.AIStudy.Study.RowArrow" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/answer_background"
    android:clipToPadding="false">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/speed_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/answer_page_gutter"
        android:paddingTop="@dimen/answer_space_4"
        android:paddingBottom="@dimen/answer_space_2"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quiz_back"
            android:src="@drawable/ic_answer_back"
            app:tint="@color/answer_primary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/game_speed_math_title"
            android:textAppearance="@style/TextAppearance.AIStudy.Answer.StepTitle" />

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_history_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="0 điểm"
            android:textColor="@color/answer_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_combo_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_combo_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="x1"
            android:textColor="@color/streak"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Timer countdown bar -->
    <ProgressBar
        android:id="@+id/progress_timer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="45"
        android:progress="45"
        android:progressDrawable="@drawable/bg_xp_progress"
        app:layout_constraintTop_toBottomOf="@id/speed_top_bar" />

    <!-- Main Game Container -->
    <ScrollView
        android:id="@+id/layout_game_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_timer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/answer_page_gutter"
            android:paddingVertical="@dimen/answer_space_4"
            app:layout_constraintWidth_max="640dp">

            <!-- Question Card -->
            <LinearLayout
                android:id="@+id/card_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_playground_card"
                android:gravity="center"
                android:minHeight="170dp"
                android:orientation="vertical"
                android:padding="@dimen/answer_space_6">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_history_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/answer_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Thứ tự phép tính" />

                <TextView
                    android:id="@+id/tv_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Question"
                    android:textSize="32sp"
                    tools:text="7 × 8 + 15 = ?" />

                <TextView
                    android:id="@+id/tv_feedback_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/answer_foreground_secondary"
                    android:textSize="13sp"
                    android:visibility="invisible"
                    tools:text="+10 điểm"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 4 Answer Options in 2x2 Grid / Vertical layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_option_0"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_playground_choice"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:textColor="@color/answer_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/answer_surface"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:strokeColor="@color/answer_divider"
                        app:strokeWidth="1.5dp"
                        tools:text="68" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_option_1"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_playground_choice"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:textColor="@color/answer_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/answer_surface"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:strokeColor="@color/answer_divider"
                        app:strokeWidth="1.5dp"
                        tools:text="71" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_option_2"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_playground_choice"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:textColor="@color/answer_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/answer_surface"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:strokeColor="@color/answer_divider"
                        app:strokeWidth="1.5dp"
                        tools:text="81" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_option_3"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_playground_choice"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:textColor="@color/answer_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/answer_surface"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:strokeColor="@color/answer_divider"
                        app:strokeWidth="1.5dp"
                        tools:text="59" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/answer_foreground_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Thời gian còn lại: 45s" />

        </LinearLayout>
    </ScrollView>

    <!-- Result / Game Over Overlay -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/answer_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/answer_page_gutter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_playground_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintWidth_max="480dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_level_badge"
                android:gravity="center"
                android:text="⚡"
                android:textColor="@color/answer_on_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/game_result_game_over"
                android:textAppearance="@style/TextAppearance.AIStudy.Answer.Question" />

            <TextView
                android:id="@+id/tv_result_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_history_chip_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="+45 XP"
                android:textColor="@color/answer_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_result_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tổng điểm: 180"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />

                <TextView
                    android:id="@+id/tv_result_correct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Số câu đúng: 12 / 14"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />

                <TextView
                    android:id="@+id/tv_result_max_combo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chuỗi combo cao nhất: x6"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_again"
                style="@style/Widget.AIStudy.Study.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/game_btn_play_again"
                app:icon="@drawable/ic_study_arrow"
                app:iconGravity="textEnd" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_done"
                style="@style/Widget.AIStudy.Answer.Back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/game_btn_back_playground" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


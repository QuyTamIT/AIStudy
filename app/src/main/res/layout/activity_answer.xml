<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/answer_background">

    <LinearLayout android:id="@+id/answer_toolbar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/answer_page_gutter"
        android:paddingVertical="@dimen/answer_space_3" android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/answer_column_width">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back" style="@style/Widget.AIStudy.Answer.Back"
        android:layout_width="@dimen/answer_touch_target" android:layout_height="@dimen/answer_touch_target"
        android:padding="@dimen/answer_space_3" android:contentDescription="@string/answer_back"
        app:icon="@drawable/ic_answer_back" app:iconGravity="textStart"
        app:iconPadding="0dp" app:iconSize="24dp" />

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="@dimen/answer_space_4"
            android:text="@string/answer_screen_title"
            android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
    </LinearLayout>

    <View android:id="@+id/answer_toolbar_rule"
        android:layout_width="0dp" android:layout_height="@dimen/answer_rule_width"
        android:background="@color/answer_divider"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/answer_toolbar" />

    <ScrollView android:id="@+id/answer_scroll"
        android:layout_width="0dp" android:layout_height="0dp"
        android:clipToPadding="false" android:descendantFocusability="beforeDescendants"
        android:fillViewport="true" android:focusableInTouchMode="true"
        android:paddingHorizontal="@dimen/answer_page_gutter" android:scrollbarStyle="outsideOverlay"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/answer_toolbar_rule">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <ProgressBar android:id="@+id/progress_answer_loading"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_marginTop="@dimen/answer_space_12"
                android:contentDescription="@string/answer_loading"
                android:indeterminateTint="@color/answer_primary"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout android:id="@+id/answer_content"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="@dimen/answer_space_8"
                android:paddingBottom="@dimen/answer_space_12" android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/answer_column_width" tools:visibility="visible">

                <!-- Header: Subject + Difficulty Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/tv_subject"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_answer_subject"
                        android:paddingHorizontal="@dimen/answer_space_3" android:paddingVertical="@dimen/answer_space_2"
                        android:drawableStart="@drawable/ic_answer_book" android:drawablePadding="@dimen/answer_space_2"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Subject" tools:text="Math" />

                    <TextView android:id="@+id/tv_difficulty"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/answer_space_2"
                        android:background="@drawable/bg_difficulty_badge"
                        android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                        android:textColor="@color/answer_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Medium" />
                </LinearLayout>

                <TextView android:id="@+id/tv_question"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_4" android:accessibilityHeading="true"
                    android:breakStrategy="high_quality" android:textIsSelectable="true"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Question"
                    tools:text="Solve x² − 5x + 6 = 0." />

                <!-- Attached image (Phase 10) -->
                <LinearLayout
                    android:id="@+id/layout_answer_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_4"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/answer_image_label"
                        android:textAllCaps="true"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/answer_divider">

                        <ImageView
                            android:id="@+id/img_answer"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/answer_image_label"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/answer_rule_width"
                    android:layout_marginTop="@dimen/answer_space_8"
                    android:background="@color/answer_divider" android:importantForAccessibility="no" />

                <LinearLayout android:id="@+id/layout_explanation_heading"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_6"
                    android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tv_answer_explanation_heading"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:accessibilityHeading="true"
                    android:text="@string/answer_explanation"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <TextView android:id="@+id/tv_answer_step_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/answer_space_3"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label" tools:text="3 steps" />
                </LinearLayout>

                <LinearLayout android:id="@+id/layout_steps"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_6"
                    android:orientation="vertical" />

                <LinearLayout android:id="@+id/layout_final_answer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/answer_space_8"
                    android:background="@drawable/bg_answer_result"
                    android:orientation="vertical" android:padding="@dimen/answer_space_6">

                    <TextView android:id="@+id/tv_final_title"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_answer_result_label"
                        android:paddingHorizontal="@dimen/answer_space_3" android:paddingVertical="@dimen/answer_space_2"
                        android:drawableStart="@drawable/ic_answer_check" android:drawablePadding="@dimen/answer_space_2"
                        android:gravity="center_vertical"
                        android:accessibilityHeading="true" android:text="@string/answer_final_title"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.ResultLabel" />

                    <TextView android:id="@+id/tv_final_answer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_4" android:breakStrategy="high_quality"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Result"
                        android:textIsSelectable="true" tools:text="x = 2 or x = 3" />
                </LinearLayout>

                <LinearLayout android:id="@+id/layout_more_topics"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone" tools:visibility="visible">

                    <View android:layout_width="match_parent" android:layout_height="@dimen/answer_rule_width"
                        android:layout_marginBottom="@dimen/answer_space_6"
                        android:background="@color/answer_divider" android:importantForAccessibility="no" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityHeading="true" android:text="@string/answer_more_heading"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_2"
                        android:orientation="horizontal" android:gravity="center_vertical">
                    <ProgressBar android:id="@+id/progress_more_topics"
                        android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/answer_space_2"
                        android:importantForAccessibility="no" android:indeterminateTint="@color/answer_primary"
                        android:visibility="gone" />
                    <TextView android:id="@+id/tv_more_status"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label" tools:text="More topics: 0 of 5 used" />
                    </LinearLayout>

                    <TextView android:id="@+id/tv_more_error"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3" android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_answer_error" android:padding="@dimen/answer_space_4"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label"
                        android:textColor="@color/answer_error" android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_more_topics"
                        style="@style/Widget.AIStudy.Answer.More"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_4" android:text="@string/answer_more_topics"
                        app:icon="@drawable/ic_answer_more" app:iconGravity="textEnd"
                        app:iconPadding="@dimen/answer_space_3" app:iconSize="20dp" />
                </LinearLayout>

                <!-- Learning Extras Section (Phase 9) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/answer_rule_width"
                    android:layout_marginTop="@dimen/answer_space_6"
                    android:layout_marginBottom="@dimen/answer_space_4"
                    android:background="@color/answer_divider"
                    android:importantForAccessibility="no" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_simplify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_answer_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="@string/answer_action_simplify"
                            android:textColor="@color/answer_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_alternative"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_answer_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="@string/answer_action_alternative"
                            android:textColor="@color/answer_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_concepts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_answer_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="@string/answer_action_concepts"
                            android:textColor="@color/answer_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_mistakes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_answer_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="@string/answer_action_mistakes"
                            android:textColor="@color/answer_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_followups"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_answer_action"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="@string/answer_action_followups"
                            android:textColor="@color/answer_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_answer_extras_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ProgressBar
                        android:id="@+id/progress_extras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:indeterminateTint="@color/answer_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_extras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/answer_extras_empty"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_practice"
                    style="@style/Widget.AIStudy.Answer.More"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/quiz_practice"
                    app:backgroundTint="@color/answer_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mark_reviewed"
                    style="@style/Widget.AIStudy.Answer.More"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/answer_mark_reviewed"
                    app:backgroundTint="@color/answer_primary"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

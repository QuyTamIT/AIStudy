<?xml version="1.0" encoding="utf-8"?>
<!-- Home v2 (Phase 6): Deep Sage learning workspace, learner level, streak,
     XP progress bar, question prompt, recent question, and subject stats.
     Room owns all progress. Centered 720dp column contracts naturally. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/answer_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/answer_page_gutter"
            android:orientation="vertical"
            android:paddingTop="@dimen/answer_space_4"
            android:paddingBottom="@dimen/answer_space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/home_column_width">

            <!-- Top bar: Brand + Logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_brand"
                    android:textAppearance="@style/TextAppearance.AIStudy.Home.Brand" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/logout"
                    android:textColor="@color/logout_pill_fg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="@color/logout_pill_bg"
                    app:strokeColor="@color/logout_pill_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="@color/logout_pill_fg"
                    app:iconSize="15dp"
                    app:iconPadding="6dp"
                    app:iconGravity="textStart"
                    app:rippleColor="@color/logout_pill_ripple" />
            </LinearLayout>

            <!-- Greeting & Subtitle -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.AIStudy.Answer.Question"
                tools:text="Hi, Linh" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_1"
                android:text="@string/home_subtitle"
                android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />

            <!-- Profile Context (Tags from Onboarding) -->
            <LinearLayout
                android:id="@+id/home_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_3"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/home_profile_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Subject"
                    tools:text="High school · Step by step" />

                <TextView
                    android:id="@+id/home_interests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_1"
                    android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label"
                    tools:text="Your interests: Math, Science" />
            </LinearLayout>

            <!-- Learner Level, Streak & XP Progress Card (Phase 5) -->
            <LinearLayout
                android:id="@+id/home_progress_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="@dimen/answer_space_6">

                <!-- Header: Level Badge & Scholar on left, Streak Pill on right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_level_label"
                            android:textAllCaps="true"
                            android:textColor="@color/answer_foreground_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_level_badge"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_level_badge"
                                android:gravity="center"
                                android:textColor="@color/answer_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/home_scholar"
                                android:textColor="@color/answer_foreground"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_streak_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/streak"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="0 days" />
                </LinearLayout>

                <!-- XP Label & Percentage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_4"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_xp_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="0 / 1200 XP" />

                    <TextView
                        android:id="@+id/tv_xp_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/answer_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="0%" />
                </LinearLayout>

                <!-- Horizontal XP Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_xp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_xp_progress"
                    tools:progress="25" />
            </LinearLayout>

            <!-- Hero Action Card: Ask a question (Deep Sage signature) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:background="@drawable/bg_home_hero"
                android:orientation="vertical"
                android:padding="@dimen/answer_space_6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:breakStrategy="balanced"
                    android:text="@string/home_hero_title"
                    android:textAppearance="@style/TextAppearance.AIStudy.Home.Hero" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_3"
                    android:text="@string/home_hero_body"
                    android:textAppearance="@style/TextAppearance.AIStudy.Home.HeroBody" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ask"
                    style="@style/Widget.AIStudy.Home.Ask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_6"
                    android:text="@string/home_ask_cta"
                    app:icon="@drawable/ic_study_arrow"
                    app:iconGravity="textEnd" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_practice_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/quiz_practice"
                    android:visibility="gone"
                    app:backgroundTint="@color/auth_brand"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Topic Review Suggestion (Phase 12) -->
            <LinearLayout
                android:id="@+id/card_review_suggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_review_title"
                    android:textAllCaps="true"
                    android:textColor="@color/answer_foreground_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_review_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/answer_foreground"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Review: Math" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_review_cta"
                    android:textColor="@color/answer_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recent Question Section (Phase 6) -->
            <LinearLayout
                android:id="@+id/section_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Section Header: RECENT QUESTION + View all -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_recent_title"
                        android:textAllCaps="true"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:text="@string/home_view_all"
                        android:textColor="@color/answer_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recent Question Card -->
                <LinearLayout
                    android:id="@+id/card_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/answer_space_2"
                    android:background="@drawable/bg_home_card"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_6">

                    <TextView
                        android:id="@+id/tv_recent_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/answer_foreground"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Solve x² − 5x + 6 = 0." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_recent_subject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/answer_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Math" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/answer_foreground_secondary"
                            android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Subject Stats Section (Phase 6) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_6"
                android:text="@string/home_subjects_title"
                android:textAllCaps="true"
                android:textColor="@color/answer_foreground_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Row 1: Math & Science -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_3"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_subject_math"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_4">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_subject_icon"
                        android:gravity="center"
                        android:text="@string/home_subject_math_icon"
                        android:textColor="@color/answer_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:text="@string/subject_math"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_math"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        tools:text="0 questions" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_subject_science"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_4">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_subject_icon"
                        android:gravity="center"
                        android:text="@string/home_subject_science_icon"
                        android:textColor="@color/answer_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:text="@string/subject_science"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_science"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        tools:text="0 questions" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Programming (Code) & History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_subject_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_4">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_subject_icon"
                        android:gravity="center"
                        android:text="@string/home_subject_code_icon"
                        android:textColor="@color/answer_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:text="@string/subject_code"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        tools:text="0 questions" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_subject_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_4">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_subject_icon"
                        android:gravity="center"
                        android:text="@string/home_subject_history_icon"
                        android:textColor="@color/answer_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:text="@string/subject_history"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        tools:text="0 questions" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Language & Spacer (Phase 9) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_subject_language"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:orientation="vertical"
                    android:padding="@dimen/answer_space_4">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_subject_icon"
                        android:gravity="center"
                        android:text="@string/home_subject_language_icon"
                        android:textColor="@color/answer_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/answer_space_3"
                        android:text="@string/subject_language"
                        android:textColor="@color/answer_foreground"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/answer_foreground_secondary"
                        android:textSize="11sp"
                        tools:text="0 questions" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

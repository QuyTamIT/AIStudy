<?xml version="1.0" encoding="utf-8"?>
<!-- Deep Sage / Operate: the same open form as Sign in, with name first and no extra steps.
     Growing fields, persistent labels, and one-column reading survive small screens and the IME. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/answer_background" android:fillViewport="true" android:clipToPadding="false"
    android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/answer_page_gutter" android:orientation="vertical"
            android:paddingVertical="@dimen/answer_space_8"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/study_form_width">
            <include layout="@layout/include_study_brand" />

            <TextView android:id="@+id/tv_auth_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_12" android:accessibilityHeading="true"
                android:text="@string/auth_register_title" android:textAppearance="@style/TextAppearance.AIStudy.Study.Display" />
            <TextView android:id="@+id/tv_auth_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/answer_space_2" android:text="@string/auth_register_subtitle"
                android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />

            <LinearLayout android:id="@+id/layout_auth_form" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_8" android:orientation="vertical">
                <include layout="@layout/include_study_name" />
                <include layout="@layout/include_study_email" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_4" />
                <include layout="@layout/include_study_password" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_4" />
                <include layout="@layout/include_study_auth_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_6" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit"
                    style="@style/Widget.AIStudy.Study.Primary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/auth_register_submit" />
                <include layout="@layout/include_study_auth_loading" />
            </LinearLayout>

            <View style="@style/Widget.AIStudy.Study.Rule" android:layout_marginTop="@dimen/answer_space_8" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_toggle_mode"
                style="@style/Widget.AIStudy.Study.Link" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/answer_space_2"
                android:text="@string/auth_register_toggle" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

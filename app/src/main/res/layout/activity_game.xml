<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/answer_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <ImageButton android:id="@+id/game_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_answer_back"
            android:contentDescription="@string/quiz_back" app:tint="@color/answer_primary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:padding="12dp" android:text="@string/game_title"
            android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
    </LinearLayout>
    <ScrollView android:id="@+id/game_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/answer_page_gutter" android:orientation="vertical"
                android:paddingTop="16dp" android:paddingBottom="32dp"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="640dp">
                <LinearLayout android:id="@+id/game_setup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp"
                        android:src="@drawable/ic_study_game" android:background="@drawable/bg_subject_icon"
                        android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="@string/game_intro" android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.AIStudy.Study.Display" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/game_rules"
                        android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" android:text="@string/game_subject" android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/game_subjects"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/game_math" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"
                            android:text="@string/subject_math" app:chipIcon="@drawable/ic_study_math" app:chipIconVisible="true" />
                        <com.google.android.material.chip.Chip android:id="@+id/game_science" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/subject_science" app:chipIcon="@drawable/ic_study_science" app:chipIconVisible="true" />
                        <com.google.android.material.chip.Chip android:id="@+id/game_code" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/subject_code" app:chipIcon="@drawable/ic_study_code" app:chipIconVisible="true" />
                        <com.google.android.material.chip.Chip android:id="@+id/game_history" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/subject_history" app:chipIcon="@drawable/ic_study_history" app:chipIconVisible="true" />
                        <com.google.android.material.chip.Chip android:id="@+id/game_language" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/subject_language" app:chipIcon="@drawable/ic_study_language" app:chipIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" android:text="@string/game_mode" android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/game_modes"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/game_timed" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" android:text="@string/game_timed" />
                        <com.google.android.material.chip.Chip android:id="@+id/game_untimed" style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/game_untimed" />
                    </com.google.android.material.chip.ChipGroup>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="@string/game_timer_note"
                        android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/game_start"
                        style="@style/Widget.AIStudy.Study.Primary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="24dp"
                        android:text="@string/game_start" app:icon="@drawable/ic_study_game" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/game_offline"
                        android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />
                </LinearLayout>
                <LinearLayout android:id="@+id/game_play" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/game_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/game_time_bar"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:max="60" android:progress="60" android:importantForAccessibility="no"
                        app:indicatorColor="@color/answer_primary" app:trackColor="@color/answer_divider" />
                    <TextView android:id="@+id/game_points" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <TextView android:id="@+id/game_question_number" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />
                    <TextView android:id="@+id/game_question" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Question" />
                    <LinearLayout android:id="@+id/game_options" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
                    <TextView android:id="@+id/game_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_answer_result"
                        android:accessibilityLiveRegion="polite" android:visibility="gone"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/game_next"
                        style="@style/Widget.AIStudy.Study.Primary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone"
                        android:text="@string/quiz_next" />
                </LinearLayout>
                <LinearLayout android:id="@+id/game_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/game_result_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityHeading="true" android:text="@string/game_result"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <TextView android:id="@+id/game_result_score" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.AIStudy.Study.Display" />
                    <TextView android:id="@+id/game_result_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.AIStudy.Study.Support" />
                    <TextView android:id="@+id/game_best" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />
                    <TextView android:id="@+id/game_save_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/game_retry"
                        style="@style/Widget.AIStudy.Study.Link" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/game_retry" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/game_replay"
                        style="@style/Widget.AIStudy.Study.Primary" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/game_replay" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/game_done"
                        style="@style/Widget.AIStudy.Study.Link" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/quiz_done" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                        android:text="@string/game_review" android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Section" />
                    <LinearLayout android:id="@+id/game_reviews" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>

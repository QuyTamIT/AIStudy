<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/progress_auth" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"
    android:paddingTop="@dimen/answer_space_3" android:accessibilityLiveRegion="polite">
    <ProgressBar android:layout_width="20dp" android:layout_height="20dp"
        android:indeterminateTint="@color/answer_primary" android:importantForAccessibility="no" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="@dimen/answer_space_3" android:text="@string/auth_submit_loading"
        android:textAppearance="@style/TextAppearance.AIStudy.Answer.Label" />
</LinearLayout>

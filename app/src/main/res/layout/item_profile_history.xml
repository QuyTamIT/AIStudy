<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_answer_subject"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/answer_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Toán học" />

        <TextView
            android:id="@+id/tv_item_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_difficulty_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/answer_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Trung bình" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/answer_foreground_secondary"
            android:textSize="11sp"
            tools:text="14:30 · Hôm nay" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_item_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/answer_foreground"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Giải phương trình bậc hai x² - 5x + 6 = 0" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/answer_divider" />
</LinearLayout>

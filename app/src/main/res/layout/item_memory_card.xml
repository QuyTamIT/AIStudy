<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="115dp"
    android:layout_margin="4dp"
    android:clipToPadding="false">

    <!-- Card Face Down (Back) -->
    <LinearLayout
        android:id="@+id/layout_card_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_memory_card_back"
        android:clickable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_subject_icon"
            android:gravity="center"
            android:text="✦"
            android:textColor="@color/answer_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card Face Up (Front) -->
    <LinearLayout
        android:id="@+id/layout_card_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_memory_card_front"
        android:clickable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_card_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/answer_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Math" />

        <TextView
            android:id="@+id/tv_card_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/answer_foreground"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="a² + b² = c²" />

        <TextView
            android:id="@+id/tv_matched_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="@color/answer_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</FrameLayout>

